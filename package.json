{
  "name": "nexo-assist",
  "version": "0.1.0",
  "description": "Telegram listing-watch bot (kufar.by, realt.by) on NestJS",
  "author": "NEXO",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check --log-level warn .",
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS -r dotenv/config\" nest start",
    "start:dev": "NODE_OPTIONS=\"$NODE_OPTIONS -r dotenv/config\" nest start --watch",
    "start:debug": "NODE_OPTIONS=\"$NODE_OPTIONS -r dotenv/config\" nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:pkg-versions && npm run lint:todo-format && eslint \"{src,test}/**/*.ts\" --cache --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --cache --fix",
    "lint:pkg-versions": "node scripts/lint/check-package-versions.js",
    "lint:todo-format": "node scripts/lint/check-todo-format.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "check:dead-code": "knip",
    "notify:test": "ts-node -r tsconfig-paths/register src/scripts/notify-test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "k8s:backup:fetch": "./deploy/fetch-backup.sh",
    "dev:docker": "docker compose up --build",
    "k8s:tunnel": "./deploy/tunnel.sh",
    "k8s:secrets": "./deploy/secrets.sh",
    "k8s:status": "KUBECONFIG=$HOME/.kube/nexo.yaml kubectl get pods -o wide",
    "k8s:logs": "KUBECONFIG=$HOME/.kube/nexo.yaml kubectl logs deploy/nexo-assist -c app --tail=50 -f",
    "typeorm": "node -r dotenv/config -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@sentry/nestjs": "^10.73.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cron": "^4.4.0",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "multer": "~2.3.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,mjs,js}": [
      "prettier --write"
    ]
  }
}

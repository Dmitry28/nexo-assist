# Application
# NODE_ENV: technical runtime mode (development | production | test) — framework/tooling only.
NODE_ENV=development
# APP_ENV: deployment stage (development | staging | production | test) — drives app behavior.
# Defaults to test under jest, else development. Keep it `development` locally: `production`
# here would make the app demand the production-only settings (token, admin id, proxy,
# heartbeat) and talk to users as if it were the real bot.
APP_ENV=development
PORT=3000

# API
API_PREFIX=api
API_VERSION=1

# CORS (comma-separated origins, * for all, or empty to block all cross-origin)
CORS_ORIGIN=*

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Telegram bot. TWO bots exist, one per environment — put the **dev** bot's token here.
# The production bot's token is never in a file: it lives in the cluster Secret
# (deploy/secrets.sh) and in the password manager. Sharing one token between local and prod
# is not an option — Telegram allows a single long-polling consumer per token, so both sides
# would steal each other's updates.
# Bot stays disabled when unset — but then a local run tests everything except the bot, which
# is the part the release gate exists to check (docs/DEPLOY.md § Как код попадает в прод).
# TELEGRAM_BOT_TOKEN=

# The Bot API's address. Unset = Telegram. `npm run sim:bot` sets a fake one on localhost itself
# (src/scripts/bot-sim.ts) — never set it here for a normal run.
# TELEGRAM_API_ROOT=
# The simulator's user (`npm run sim:bot`): ADMIN_TELEGRAM_ID when set, else this (default 1).
# SIM_USER_ID=
# The simulator's app log level (default warn — only the bot's replies show).
# SIM_LOG_LEVEL=
# 1 — let the simulator file real GitHub issues (it drops GITHUB_ISSUES_TOKEN otherwise).
# SIM_GITHUB=

# Watchdog ping URL (dead-man's switch — see docs/DEPLOY.md for the setup). Unset = disabled;
# required in production. Create a free check at healthchecks.io and paste its ping URL here.
# HEARTBEAT_URL=

# Your Telegram id — enables /stats and, in production, /check, and is where every product
# alert goes. Unset = no admin (required when APP_ENV=production; kept in the Secret there,
# not the ConfigMap — the repo is public and this is a personal id).
# ADMIN_TELEGRAM_ID=

# Daily subscription check (cron), in Europe/Minsk time. Default 09:00 every day.
WATCH_CRON=0 9 * * *

# Where unhandled errors are reported (Sentry). Safe to keep set locally: reporting only fires
# when APP_ENV is production/staging, so dev runs send nothing and don't eat the free quota.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Force reporting on locally, to test that the path works end to end — run with `npm run
# start:dev`, which preloads this file before the early modules read it:
# SENTRY_ENABLED=true
# The release errors are tagged with — the image's commit, set by the Dockerfile. Unset locally.
# SENTRY_RELEASE=

# HTTP proxy for sources that block datacenter IPs (kufar). Unset = fetch everything
# directly — fine locally, since a home/office IP isn't blocked. Contains credentials,
# so in production it lives in the k8s Secret, not the ConfigMap.
# Required when APP_ENV=production: without it kufar is fetched directly, answers 403, and that
# reads as the source blocking us — the dead-link counter then auto-pauses real subscriptions.
# SCRAPE_PROXY_URL=http://user:pass@proxy-host:8888

# Paid anti-bot services for protected sources (idriver.by) — the fetch ladder's last rungs.
# Unset = only the free rungs are tried. A local key spends the same monthly free tier as prod:
# test a few pages, keep no protected subscription active locally.
# ZENROWS_API_KEY=
# SCRAPE_DO_API_KEY=
# SCRAPEOPS_API_KEY=
# SCRAPINGANT_API_KEY=
# SCRAPER_API_KEY=
# SCRAPFLY_API_KEY=

# Files a link to an unsupported site as a GitHub issue (label source-request) for adding its
# parser. Fine-grained token: this repo only, «Issues: Read and write». Unset = the link is only
# refused. A local token files into the same repo as prod.
# GITHUB_ISSUES_TOKEN=

# Pacing between subscription polls: base delay + random 0..jitter (ms).
WATCH_MIN_DELAY_MS=2000
WATCH_JITTER_MS=3000

# Database (Postgres). Defaults to the local docker DB (npm run db:up).
# In production set a Supabase URL (SSL, pooler).
DATABASE_URL=postgres://app:app@localhost:5432/app

# Observability (OpenTelemetry) — tracing starts only when the endpoint is set.
# These are read natively by the OTel SDK (see src/tracing.ts).
# OTEL_SERVICE_NAME=nexo-assist
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

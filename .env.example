# Application
# NODE_ENV: technical runtime mode (development | production | test) — framework/tooling only.
NODE_ENV=development
# APP_ENV: deployment stage (development | staging | production | test) — drives app behavior.
# Defaults to test under jest, else development.
APP_ENV=development
PORT=3000

# API
API_PREFIX=api
API_VERSION=1

# CORS (comma-separated origins, * for all, or empty to block all cross-origin)
CORS_ORIGIN=*

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Telegram bot (get a token from @BotFather). Bot stays disabled when unset.
# TELEGRAM_BOT_TOKEN=

# Your Telegram id — enables /stats and, in production, /check, and is where every product
# alert goes. Unset = no admin (required when APP_ENV=production; kept in the Secret there,
# not the ConfigMap — the repo is public and this is a personal id).
# ADMIN_TELEGRAM_ID=

# Daily subscription check (cron). Default 09:00 every day.
WATCH_CRON=0 9 * * *

# Where unhandled errors are reported (Sentry). Safe to keep set locally: reporting only fires
# when APP_ENV is production/staging, so dev runs send nothing and don't eat the free quota.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Force reporting on locally, to test that the path works end to end — run with `npm run
# start:dev`, which preloads this file before the early modules read it:
# SENTRY_ENABLED=true

# HTTP proxy for sources that block datacenter IPs (kufar). Unset = fetch everything
# directly — fine locally, since a home/office IP isn't blocked. Contains credentials,
# so in production it lives in the k8s Secret, not the ConfigMap.
# Required when APP_ENV=production: without it kufar is fetched directly, answers 403, and that
# reads as the source blocking us — the dead-link counter then auto-pauses real subscriptions.
# SCRAPE_PROXY_URL=http://user:pass@proxy-host:8888

# Pacing between subscription polls: base delay + random 0..jitter (ms).
WATCH_MIN_DELAY_MS=2000
WATCH_JITTER_MS=3000

# Database (Postgres). Defaults to the local docker DB (npm run db:up).
# In staging/prod set a Neon URL (SSL, pooled endpoint).
DATABASE_URL=postgres://app:app@localhost:5432/app

# Observability (OpenTelemetry) — tracing starts only when the endpoint is set.
# These are read natively by the OTel SDK (see src/tracing.ts).
# OTEL_SERVICE_NAME=nexo-assist
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

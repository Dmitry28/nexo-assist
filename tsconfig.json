{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // Required, not decorative: ts-jest compiles every spec through this config, and TS 6 fails
    // with TS5011 unless rootDir is explicit. Removing it turns all 29 suites red — verified.
    // The repo root is the right value here (this config spans src/ and test/); the emitting
    // build uses tsconfig.build.json, where it is ./src, so dist/ stays flat.
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // DTOs/entities are populated by class-transformer, not constructors.
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // TS 6 no longer picks up every @types package on its own, so the two that provide
    // *globals* must be named. Everything else is reached through explicit imports.
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

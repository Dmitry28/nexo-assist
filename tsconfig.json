{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    // TS 6 wants rootDir stated explicitly (TS5011). This config spans src/ and test/, so its
    // root is the repo root; the emitting build uses tsconfig.build.json, where it is ./src.
    "rootDir": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // DTOs/entities are populated by class-transformer, not constructors.
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // TS 6 no longer picks up every @types package on its own, so the two that provide
    // *globals* must be named. Everything else is reached through explicit imports.
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
